# Alex Financial Planner - Variables de Entorno
# Copia este archivo a .env y rellena tus valores reales

# ============================================================
# PARTE 1: Configuración Inicial
# ============================================================
# Tu AWS Account ID (obtenlo con: aws sts get-caller-identity --query Account --output text)
AWS_ACCOUNT_ID=123456789012

# Tu región AWS por defecto para la mayoría de la infraestructura (ejemplo: us-east-1, us-west-2, eu-west-1)
DEFAULT_AWS_REGION=us-east-1

# ============================================================
# PARTE 2: Endpoint SageMaker
# ============================================================
# Tras desplegar la Parte 2, añade el nombre del endpoint
SAGEMAKER_ENDPOINT=alex-embedding-endpoint

# ============================================================
# PARTE 3: Pipeline de Ingesta
# ============================================================
# Tras desplegar la Parte 3, añade estos valores
VECTOR_BUCKET=alex-vectors-123456789012
ALEX_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/ingest
ALEX_API_KEY=your-api-key-here

# ============================================================
# PARTE 4: Agente de Investigación
# ============================================================
# Tu API key de OpenAI para el agente de investigación
OPENAI_API_KEY=sk-...

# ============================================================
# PARTE 5: Base de Datos
# ============================================================
# Tras desplegar la Parte 5, añade estos valores
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:alex-aurora-cluster
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:alex-aurora-credentials-xxxxx

# ============================================================
# PARTE 6: Agentes
# ============================================================
# Configuración del modelo Bedrock
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Región de Bedrock (us-west-2 tiene más modelos disponibles)
BEDROCK_REGION=us-west-2

# API de Polygon.io para precios de acciones en tiempo real (regístrate gratis en polygon.io) - cambia 'free' a 'paid' si usas plan de pago
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_PLAN=free

# ============================================================
# PARTE 7: Frontend & API
# ============================================================
# La API usa la configuración de base de datos de la Parte 5 arriba (AURORA_CLUSTER_ARN, AURORA_SECRET_ARN)
# Opcional: especifica nombre de la base de datos (por defecto es "alex" si no se indica)
AURORA_DATABASE=alex

# Configuración de Clerk para validación JWT
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Configuración de SQS (se establecerá automáticamente por Terraform en el despliegue)
SQS_QUEUE_URL=

# URL del Frontend para CORS
FRONTEND_URL=http://localhost:3000
CLOUDFRONT_URL=

# ============================================================
# PARTE 8: Observabilidad (por añadir)
# ============================================================
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com